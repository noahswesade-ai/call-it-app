# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API). Without them the app still runs
# in practice mode, and on the web you can test multiplayer across browser tabs.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Filled in during the "money" phase.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
